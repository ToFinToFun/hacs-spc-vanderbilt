{
  "config": {
    "step": {
      "user": {
        "title": "Connect to your Vanderbilt SPC panel",
        "description": "Enable EDP in the panel’s global settings, then add a receiver pointing to this Home Assistant host. Use that receiver’s ID, TCP port and encryption key below.",
        "data": {
          "receiver_id": "Receiver ID",
          "port": "Listen port",
          "bind": "Bind address",
          "encryption_key": "EDP encryption key (32 hex digits, optional)"
        },
        "data_description": {
          "receiver_id": "Identifies Home Assistant’s receiver entry on the panel (1–999997). The separate EDP Panel ID identifies the alarm panel.",
          "port": "Match Receiver IP Port in the panel’s receiver entry (default 50000).",
          "bind": "Home Assistant’s local listen address. Keep 0.0.0.0 to listen on all interfaces.",
          "encryption_key": "Leave blank if EDP encryption is disabled on the panel."
        }
      },
      "reconfigure": {
        "title": "Update your Vanderbilt SPC panel connection",
        "description": "Update the matching receiver entry on the panel when changing these settings. Home Assistant restarts its listener after saving.",
        "data": {
          "receiver_id": "Receiver ID",
          "port": "Listen port",
          "bind": "Bind address",
          "encryption_key": "EDP encryption key (32 hex digits, optional)"
        },
        "data_description": {
          "receiver_id": "Identifies Home Assistant’s receiver entry on the panel (1–999997). The separate EDP Panel ID identifies the alarm panel.",
          "port": "Match Receiver IP Port in the panel’s receiver entry (default 50000).",
          "bind": "Home Assistant’s local listen address. Keep 0.0.0.0 to listen on all interfaces.",
          "encryption_key": "Leave blank if EDP encryption is disabled on the panel."
        }
      }
    },
    "error": {
      "invalid_receiver_id": "Receiver ID must be a whole number between 1 and 999997.",
      "invalid_port": "Port must be a whole number between 1 and 65535.",
      "invalid_encryption_key": "The encryption key must be exactly 32 hex digits (16 bytes), or left blank.",
      "cannot_bind": "Could not bind to that address and port. It may already be in use."
    },
    "abort": {
      "already_configured": "A receiver is already configured for that bind address and port.",
      "reconfigure_successful": "The connection settings were updated."
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Vanderbilt SPC (EDP) options",
        "data": {
          "idle_timeout": "Idle timeout (seconds)",
          "area_refresh_interval": "Area/zone reconciliation interval (seconds)",
          "reconnect_grace": "Reconnect grace period (seconds)",
          "output_poll_interval": "Output poll interval (seconds)"
        },
        "data_description": {
          "idle_timeout": "Disconnect the panel if it sends nothing for this long. The panel typically polls every ~10 seconds.",
          "area_refresh_interval": "A slower full re-sync of areas/zones to correct for any drift not covered by pushed events.",
          "reconnect_grace": "Keep the last known state this long while the panel redials its EDP link, which it does several times a day. Commands are refused until it is back. 0 marks entities unavailable immediately.",
          "output_poll_interval": "How often to read the panel's outputs, which change without an event (mapping gates, such as one following a door's lock). 0 reads them only with the reconciliation."
        }
      }
    }
  },
